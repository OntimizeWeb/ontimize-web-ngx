{
  "name": "ontimize-web-ngx",
  "version": "18.0.0-next.12",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && npm run build-theme && npm run build-styles && npm run copy-files && npm run copy-files-themes",
    "build-prod": "ng build -c production && npm run build-theme && npm run build-styles && npm run copy-files && npm run copy-files-themes",
    "build-theme": "bundle-scss --config",
    "build-styles": "scss-bundle -c scss-bundle-ontimize.config.json",
    "copy-files": "copyfiles -u 3 ./projects/ontimize-web-ngx/assets/svg/ontimize-icon-set.svg ./dist/assets && echo '----¡Assets copied!----'  ",
    "copy-files-themes": "npm run clean && gulp copy-files",
    "test": "ng test --code-coverage",
    "test-ci": "ng test --no-watch --code-coverage --browsers ChromeHeadless",
    "test-watch": "ng test --watch --code-coverage",
    "test-coverage": "ng test --no-watch --code-coverage --browsers ChromeHeadless && npm run coverage-report",
    "coverage-report": "echo Coverage report generated at coverage/ontimize-web-ngx/index.html",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "rimraf": "rimraf",
    "clean": "rimraf tmp"
  },
  "bundleStyle": {
    "dest": "./dist/theme.scss",
    "mask": [
      "./projects/ontimize-web-ngx/src/lib/components/**/*theme.scss",
      "./projects/ontimize-web-ngx/src/lib/shared/**/*theme.scss",
      "./projects/ontimize-web-ngx/src/lib/layouts/**/*theme.scss"
    ],
    "sort": [
      "o-material"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/core": "^18.2.0",
    "@angular/animations": "^18.2.0",
    "@angular/cdk": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/material": "^18.2.0",
    "@angular/material-luxon-adapter": "^18.2.14",
    "@angular/material-moment-adapter": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@ngx-translate/core": "~14.0.0",
    "@ngx-translate/http-loader": "~7.0.0",
    "angular-resizable-element": "7.0.2",
    "luxon": "^3.7.2",
    "moment": "2.29.2",
    "ngx-material-timepicker": "13.1.1",
    "ngx-skeleton-loader": "10.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular-eslint/builder": "18.4.3",
    "@angular-eslint/eslint-plugin": "18.4.3",
    "@angular-eslint/eslint-plugin-template": "18.4.3",
    "@angular-eslint/schematics": "18.4.3",
    "@angular-eslint/template-parser": "18.4.3",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@types/jasmine": "~4.3.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "bundle-scss": "^1.5.1",
    "copyfiles": "~2.2.0",
    "eslint": "^8.56.0",
    "google-libphonenumber": "^3.2.3",
    "gulp": "4.0.2",
    "gulp-cssimport": "^7.0.0",
    "gulp-replace": "1.1.4",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.2",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "karma-sonarqube-unit-reporter": "0.0.23",
    "ng-packagr": "^18.2.0",
    "rimraf": "^5.0.1",
    "scss-bundle": "3.1.1",
    "sonarqube-scanner": "^2.8.1",
    "ts-node": "~10.9.0",
    "typescript": "~5.5.0"
  }
}
